#!/usr/bin/env sh
set -eu

echo "[pre-push] Installing dependencies"
npm install

echo "[pre-push] Auditing high-severity dependency risk"
npm run audit

echo "[pre-push] Validating governed project state"
npm run validate:work-graph
npm run validate:data-inventory
npm run validate:chatgpt-release
npm run validate:chatgpt-staging

echo "[pre-push] Running TypeScript checks"
npm run typecheck

echo "[pre-push] Running tests"
npm run test

echo "[pre-push] Running build"
npm run build

echo "[pre-push] Quality gates passed"
