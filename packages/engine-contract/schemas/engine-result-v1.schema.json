{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxlien.local/schemas/engine-result-v1.schema.json",
  "title": "EngineResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "evidenceSchemaVersion",
    "requestId",
    "candidateId",
    "generatedAt",
    "status",
    "versions",
    "applicability",
    "evidenceDigest",
    "signals",
    "findings",
    "missingEvidence",
    "limitations"
  ],
  "properties": {
    "contractVersion": { "const": "1.1.0" },
    "evidenceSchemaVersion": { "const": "1.1.0" },
    "requestId": { "$ref": "#/$defs/nonEmptyString" },
    "candidateId": { "$ref": "#/$defs/nonEmptyString" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["assessed", "insufficient_evidence", "out_of_scope"] },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineVersion", "rulePackVersion", "evidenceVersion"],
      "properties": {
        "engineVersion": { "$ref": "#/$defs/nonEmptyString" },
        "rulePackVersion": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceVersion": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "jurisdiction", "reason", "sourceRefs"],
      "properties": {
        "status": { "enum": ["applicable", "unknown", "out_of_scope"] },
        "jurisdiction": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": { "$ref": "#/$defs/stringArray" },
        "rulePackId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidenceDigest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "missingEvidence": { "$ref": "#/$defs/stringArray" },
    "limitations": { "$ref": "#/$defs/stringArray" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "assessed" } } },
      "then": {
        "properties": {
          "applicability": {
            "properties": { "status": { "const": "applicable" } }
          },
          "signals": {
            "contains": { "properties": { "status": { "const": "available" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "out_of_scope" } } },
      "then": {
        "properties": {
          "applicability": {
            "properties": { "status": { "const": "out_of_scope" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "version",
        "sha256",
        "trainingDatasetVersion",
        "evaluationReportUri"
      ],
      "properties": {
        "modelId": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "trainingDatasetVersion": { "$ref": "#/$defs/nonEmptyString" },
        "evaluationReportUri": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "status",
        "method",
        "unit",
        "evidenceRefs",
        "explanation",
        "missingEvidence"
      ],
      "properties": {
        "key": {
          "enum": [
            "value_coverage_ratio",
            "redemption_heuristic_signal",
            "redemption_probability",
            "liquidity_score",
            "risk_score",
            "investment_score"
          ]
        },
        "status": { "enum": ["available", "unknown", "unavailable", "not_applicable"] },
        "method": { "enum": ["deterministic", "heuristic", "model", "not_computed"] },
        "unit": { "enum": ["ratio", "score", "probability"] },
        "value": { "type": "number" },
        "evidenceRefs": { "$ref": "#/$defs/stringArray" },
        "explanation": { "$ref": "#/$defs/nonEmptyString" },
        "missingEvidence": { "$ref": "#/$defs/stringArray" },
        "modelArtifact": { "$ref": "#/$defs/modelArtifact" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": {
            "required": ["value"],
            "properties": { "method": { "not": { "const": "not_computed" } } }
          },
          "else": {
            "not": { "required": ["value"] },
            "properties": { "method": { "const": "not_computed" } }
          }
        },
        {
          "if": { "properties": { "method": { "const": "model" } } },
          "then": { "required": ["modelArtifact"] },
          "else": { "not": { "required": ["modelArtifact"] } }
        },
        {
          "if": {
            "properties": {
              "key": { "const": "redemption_probability" },
              "status": { "const": "available" }
            }
          },
          "then": {
            "properties": {
              "method": { "const": "model" },
              "unit": { "const": "probability" },
              "value": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "key": { "const": "value_coverage_ratio" } } },
          "then": {
            "properties": {
              "unit": { "const": "ratio" },
              "value": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "key": { "const": "redemption_heuristic_signal" } } },
          "then": {
            "properties": {
              "unit": { "const": "score" },
              "value": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": { "const": "redemption_heuristic_signal" },
              "status": { "const": "available" }
            }
          },
          "then": { "properties": { "method": { "const": "heuristic" } } }
        },
        {
          "if": {
            "properties": {
              "key": { "enum": ["liquidity_score", "risk_score", "investment_score"] }
            }
          },
          "then": {
            "properties": {
              "unit": { "const": "score" },
              "value": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "evidenceRefs"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["info", "warning", "exclusion"] },
        "message": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRefs": { "$ref": "#/$defs/stringArray" },
        "ruleId": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
