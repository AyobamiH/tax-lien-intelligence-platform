NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
OPERATIONAL_LOGGING_ENABLED=false
MONGODB_URI=mongodb://localhost:27017/tax_lien_platform
MONGODB_DB_NAME=tax_lien_platform
JWT_SECRET=replace-with-a-long-random-secret-before-production
CORS_ALLOWED_ORIGINS=http://localhost:5173
SCORING_REQUEST_LIMIT_WINDOW_MS=60000
SCORING_REQUEST_LIMIT_MAX=20
CENSUS_GEOCODER_ENABLED=false
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current
CENSUS_GEOCODER_TIMEOUT_MS=3000
CENSUS_GEOCODER_MAX_ROWS_PER_JOB=25
ENRICHMENT_FRESHNESS_WINDOW_DAYS=30
MAINTENANCE_SCAN_INTERVAL_MS=3600000
MAINTENANCE_AUTO_REFRESH_ENABLED=false
MAINTENANCE_MAX_DATASETS_PER_RUN=25
MAINTENANCE_MIN_REFRESH_INTERVAL_HOURS=24
MAINTENANCE_FAILURE_SUPPRESSION_HOURS=24
FOLLOW_UP_REMINDER_INTERVAL_MS=3600000
INTELLIGENCE_HOST=127.0.0.1
INTELLIGENCE_PORT=8081
INTELLIGENCE_MAX_BODY_BYTES=1048576
INTELLIGENCE_SERVICE_TOKEN=replace-with-at-least-32-random-characters
INTELLIGENCE_ALLOW_INSECURE_LOCALHOST=false
INTELLIGENCE_SERVICE_ENABLED=false
INTELLIGENCE_SERVICE_BASE_URL=http://127.0.0.1:8081
INTELLIGENCE_SERVICE_TIMEOUT_MS=5000
INTELLIGENCE_SERVICE_MAX_CONCURRENCY=8
MCP_APP_BASE_URL=
# Publishable ChatGPT MCP authorization. Keep disabled until the exact public HTTPS
# issuer/resource and signing secret are owned by the deployment operator.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_RESOURCE_URL=
MCP_OAUTH_ALLOWED_CLIENT_IDS=https://chatgpt.com/oauth/client.json
MCP_OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
MCP_OAUTH_SCOPE=tax_lien:read
MCP_OAUTH_SIGNING_SECRET=
MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=604800
MCP_OAUTH_RATE_LIMIT_WINDOW_MS=60000
MCP_OAUTH_RATE_LIMIT_MAX=30
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tax Lien Intelligence Platform
EMAIL_REPLY_TO=
EMAIL_APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=10000
EMAIL_DIGEST_PROCESSING_INTERVAL_MS=86400000
EMAIL_DIGEST_MAX_USERS_PER_RUN=100
EMAIL_DIGEST_MAX_ITEMS_PER_BATCH=50
VITE_API_BASE_URL=http://localhost:4000
