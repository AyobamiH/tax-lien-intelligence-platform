FROM node:24-bookworm-slim AS build

WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build --workspaces --if-present
RUN npm prune --omit=dev

FROM python:3.12-slim AS runtime

ENV NODE_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/intelligence/src

WORKDIR /app

RUN addgroup --system taxlien && adduser --system --ingroup taxlien taxlien

COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build --chown=taxlien:taxlien /app/node_modules ./node_modules
COPY --from=build --chown=taxlien:taxlien /app/package.json /app/package-lock.json ./
COPY --from=build --chown=taxlien:taxlien /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=taxlien:taxlien /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=taxlien:taxlien /app/packages ./packages
COPY --from=build --chown=taxlien:taxlien /app/services/intelligence/src ./services/intelligence/src
COPY --from=build --chown=taxlien:taxlien /app/infra/cloudflare/entrypoint.py ./infra/cloudflare/entrypoint.py

RUN python -m compileall -q /app/services/intelligence/src /app/infra/cloudflare/entrypoint.py

USER taxlien

EXPOSE 4000 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4000/readyz', timeout=3).read()"]

ENTRYPOINT ["python", "/app/infra/cloudflare/entrypoint.py"]
