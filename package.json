{
  "name": "tax-lien-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for scoring tax lien and parcel datasets.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra/cloudflare",
    "packages/*"
  ],
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build": "npm run build --workspaces --if-present && npm run build:intelligence:python",
    "build:intelligence:python": "PYTHONPATH=services/intelligence/src python3 -m compileall -q services/intelligence/src services/intelligence/tests infra/cloudflare/entrypoint.py",
    "dev:api": "npm run dev -w @tax-lien/api",
    "dev:worker": "npm run dev:worker -w @tax-lien/api",
    "dev:web": "npm run dev -w @tax-lien/web",
    "ingest:chatgpt-real-data-pilot": "node scripts/ingestion/chatgpt-real-data-pilot.mjs",
    "smoke:browser": "vitest run tests/unit/web-app-smoke.test.ts tests/unit/follow-up-browser-smoke.test.ts tests/unit/intelligence-ui.test.ts --testTimeout=60000",
    "smoke:follow-ups:browser": "vitest run tests/unit/follow-up-browser-smoke.test.ts --testTimeout=60000",
    "smoke:intelligence-service": "npm run build:intelligence:python && vitest run tests/integration/intelligence-service.test.ts --testTimeout=60000",
    "smoke:intelligence:mongo": "npm run build && node scripts/mongo-intelligence-smoke.mjs",
    "smoke:local": "npm run build && node scripts/local-runtime-smoke.mjs",
    "smoke:mongo": "npm run build && node scripts/mongo-follow-up-smoke.mjs",
    "smoke:oauth:mongo": "npm run build && node scripts/mongo-oauth-smoke.mjs",
    "test": "npm run test:intelligence:python && vitest run --testTimeout=60000",
    "test:chatgpt-pilot-bootstrap": "node scripts/test-chatgpt-pilot-bootstrap.mjs",
    "test:chatgpt-pilot-credential-recovery": "node scripts/test-chatgpt-pilot-credential-recovery.mjs",
    "test:chatgpt-real-data-pilot": "node scripts/test-chatgpt-real-data-pilot.mjs && node scripts/test-chatgpt-real-data-pilot-integration.mjs",
    "test:intelligence:python": "PYTHONPATH=services/intelligence/src python3 -m unittest discover -s services/intelligence/tests -p 'test_*.py'",
    "typecheck": "tsc -b",
    "validate:data-inventory": "node scripts/validate-data-source-inventory.mjs",
    "validate:chatgpt-release": "node scripts/validate-chatgpt-release.mjs",
    "validate:chatgpt-staging": "node scripts/validate-chatgpt-staging.mjs",
    "validate:chatgpt-pilot-bootstrap": "node scripts/validate-chatgpt-pilot-bootstrap.mjs",
    "validate:chatgpt-pilot-credential-recovery": "node scripts/validate-chatgpt-pilot-credential-recovery.mjs",
    "validate:chatgpt-real-data-pilot": "node scripts/validate-chatgpt-real-data-pilot.mjs",
    "verify:chatgpt-staging:live": "node scripts/verify-chatgpt-staging-live.mjs",
    "verify:chatgpt-staging:revision": "node scripts/wait-chatgpt-staging-revision.mjs",
    "verify:chatgpt-staging:authenticated-live": "node scripts/verify-chatgpt-staging-authenticated-live.mjs",
    "provision:chatgpt-staging:pilot": "node scripts/provision-chatgpt-staging-pilot.mjs",
    "recover:chatgpt-staging:pilot-credentials": "node scripts/recover-chatgpt-staging-pilot-credentials.mjs",
    "validate:work-graph": "node scripts/validate-work-graph.mjs",
    "verify:chatgpt-staging:log-redaction-live": "node scripts/verify-chatgpt-staging-log-redaction-live.mjs",
    "verify:chatgpt-staging:rollback-live": "node scripts/verify-chatgpt-staging-rollback-live.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "multer": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.22",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "postcss-selector-parser": "6.1.4"
  }
}
